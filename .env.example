# Temporary bootstrap secret; first login requires setting a private admin password.
# Use a unique random value and keep this file private.
ADMIN_PASSWORD=replace-with-a-unique-random-bootstrap-secret

# In local development, this database is stored inside the project directory.
DATABASE_PATH=./data/offerfolio.sqlite

# Set true when serving the app through HTTPS.
COOKIE_SECURE=false

# Browser port for Docker Compose.
APP_PORT=5188
