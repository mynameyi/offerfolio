# The admin password must be set before using /admin.
ADMIN_PASSWORD=replace-with-a-long-random-password

# In local development, this database is stored inside the project directory.
DATABASE_PATH=./data/offerfolio.sqlite

# Set true when serving the app through HTTPS.
COOKIE_SECURE=false

# Optional IP138 server-side IP geolocation API token. Keep the token secret.
IP138_TOKEN=

# Browser port for Docker Compose.
APP_PORT=5188
